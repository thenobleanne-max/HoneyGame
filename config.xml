<?xml version='1.0' encoding='utf-8'?>
<widget id="com.anne.honeygame" version="1.0.0" xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0">
  <name>HoneyGame</name>
  <description>HoneyGame — zodiac, personality, and self-discovery. Made with love by Anne.</description>
  <author email="anne@example.com" href="https://cordova.apache.org">Anne</author>
  <content src="index.html" />
  <access origin="*" />
  <allow-intent href="http://*/*" />
  <allow-intent href="https://*/*" />
  <preference name="AndroidXEnabled" value="true" />
  <preference name="DisallowOverscroll" value="true" />
  <preference name="Fullscreen" value="false" />
  <platform name="android">
    <preference name="android-minSdkVersion" value="24" />
    <preference name="android-targetSdkVersion" value="35" />
  </platform>
</widget>
